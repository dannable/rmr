# Copy to .env and fill in real values. .env is gitignored.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Comma-separated list of guild IDs the bot syncs slash commands to.
# Guild-scoped sync is instant; global sync takes ~1 hour. Use guild IDs
# during development and for any small/private deployment. Leave blank
# to fall back to global sync.
GUILD_IDS=

# Path to the SQLite DB. Default is ./rmfrp.db relative to the project root.
# In Docker this is set to a path inside the persistent volume.
# DB_PATH=
