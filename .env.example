# Copy to .env and fill in real values. .env is gitignored.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Comma-separated list of guild IDs the bot syncs slash commands to.
# Guild-scoped sync is instant; global sync takes ~1 hour. Use guild IDs
# during development and for any small/private deployment. Leave blank
# to fall back to global sync.
GUILD_IDS=

# Path to the SQLite DB. Default is ./rmfrp.db relative to the project root.
# In Docker this is set to a path inside the persistent volume.
# DB_PATH=

# --- Web app (rmr-web) ---------------------------------------------------

# Discord OAuth2 client. Register a NEW app (or reuse the bot app's OAuth2
# section) at https://discord.com/developers/applications. Add the redirect
# URI below to the OAuth2 "Redirects" list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where Discord sends the user after authorising. Must match EXACTLY what
# you configured in the Discord developer portal.
#   Local dev: http://localhost:8000/auth/discord/callback
#   Prod:      https://rolemaster.blackspiral.ca/auth/discord/callback
WEB_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Where the browser is sent after a successful login (the SPA origin).
#   Local dev: http://localhost:5173 (Vite)
#   Prod:      https://rolemaster.blackspiral.ca  (same origin — FastAPI serves SPA)
WEB_CLIENT_URL=http://localhost:5173

# Secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SESSION_SECRET=

# Allow http (non-secure) cookies. 1 for local dev, 0 behind TLS in prod.
WEB_INSECURE_COOKIES=1

# --- Reverse-proxy topology (prod only) ----------------------------------

# Bind address on the docker host for rmr-web's published port.
#   Local dev:                    127.0.0.1     (loopback, default)
#   Prod with proxy on same host: 127.0.0.1
#   Prod with proxy on ravenloft: 192.168.1.61  (thematrix's LAN IP, so ravenloft can reach it)
# If you set this to 0.0.0.0, lock the port down with a firewall.
WEB_BIND_ADDR=127.0.0.1

# Source IPs that uvicorn trusts for X-Forwarded-* headers. When the reverse
# proxy lives on a different host, this MUST be that host's source IP as seen
# from this docker host — otherwise FastAPI sees http and sets cookies
# without the Secure flag.
#   Same-host proxy: 127.0.0.1
#   ravenloft on the LAN: 192.168.1.64
FORWARDED_ALLOW_IPS=127.0.0.1
